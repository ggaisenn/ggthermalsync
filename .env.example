# Host ports. Keep services on loopback when placing a TLS reverse proxy in front.
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=3000
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_HTTP_PORT=8080
TELEMETRY_BIND_ADDRESS=127.0.0.1
TELEMETRY_TCP_PORT=9001

# Generate a unique value with: openssl rand -hex 32
SIMULATION_PROXY_TOKEN=replace-with-a-unique-random-value

# Optional telemetry tuning
HISTORY_CAPACITY=3600
WS_BROADCAST_EVERY=5
MOCK_TELEMETRY_HZ=20
